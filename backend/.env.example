# Express server port (automatically provided by Render)
PORT=5000

# Secret key for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL allowed to make CORS requests to this backend
FRONTEND_URL=https://shopease-frontend.onrender.com

# SQLite database path (optional override)
DB_FILE=database/shopease.db

# Environment mode
NODE_ENV=production
